#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Prefer the Homebrew Ruby used for this site's local development.
if command -v brew >/dev/null 2>&1; then
  ruby_prefix="$(brew --prefix ruby@3.3 2>/dev/null || true)"
  if [[ -x "$ruby_prefix/bin/ruby" ]]; then
    export PATH="$ruby_prefix/bin:$PATH"
  fi
fi

if [[ -d .bundle/python/bin ]]; then
  export PATH="$PWD/.bundle/python/bin:$PATH"
fi

export JEKYLL_ENV=development
exec bundle exec jekyll serve --host 127.0.0.1 --livereload "$@"
